<UserControl x:Class="AutoSwitcher.TemplateEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Frame" CornerRadius="10" Background="{StaticResource FieldDeepBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MinHeight="44">
        <Grid>
            <TextBlock x:Name="Placeholder" Foreground="#707070" Margin="16,0,12,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" FontSize="14"/>
            <RichTextBox x:Name="Box" Background="Transparent" BorderThickness="0" Padding="12,9,12,9"
                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         SelectionBrush="{StaticResource AccentBrush}" FontFamily="{StaticResource UiFont}" FontSize="14"
                         AcceptsReturn="False" AcceptsTab="False" IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                         VerticalAlignment="Center" FocusVisualStyle="{x:Null}"
                         TextChanged="Box_TextChanged" PreviewKeyDown="Box_PreviewKeyDown"
                         GotKeyboardFocus="Box_FocusChanged" LostKeyboardFocus="Box_FocusChanged">
                <FlowDocument PagePadding="0" LineHeight="26"/>
            </RichTextBox>
        </Grid>
    </Border>
</UserControl>
