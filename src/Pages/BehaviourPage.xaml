<UserControl x:Class="AutoSwitcher.BehaviourPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoSwitcher">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,24">
            <TextBlock Text="Behaviour" Style="{StaticResource H1}"/>

            <TextBlock Text="SWITCH CATEGORY WHEN…" Style="{StaticResource Caps}" Margin="0,20,0,8"/>
            <UniformGrid Columns="2">
                <RadioButton x:Name="ModeLaunch" Style="{StaticResource OptionCard}" GroupName="Mode" Margin="0,0,6,0" Checked="Mode_Checked">
                    <StackPanel>
                        <TextBlock Text="A game launches" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Switches when a mapped game starts. Best if you run one game at a time."
                                   Style="{StaticResource Sub}" FontSize="13" Foreground="#B5B5B5" Margin="0,5,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeFocus" Style="{StaticResource OptionCard}" GroupName="Mode" Margin="6,0,0,0" Checked="Mode_Checked">
                    <StackPanel>
                        <TextBlock Text="A game window is focused" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Switches as you click between open games. Best for multiworlds with several games open."
                                   Style="{StaticResource Sub}" FontSize="13" Foreground="#B5B5B5" Margin="0,5,0,0"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Border x:Name="DelayCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource FieldDeepBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="24" Padding="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnBase}" Background="Transparent" Width="44" Padding="0" FontSize="20"
                                    Content="−" ToolTip="Decrease" Click="DelayDown_Click"/>
                            <TextBlock x:Name="DelayText" MinWidth="56" TextAlignment="Center" VerticalAlignment="Center"
                                       FontSize="16" FontWeight="Bold"/>
                            <Button Style="{StaticResource BtnBase}" Background="Transparent" Width="44" Padding="0" FontSize="20"
                                    Content="+" ToolTip="Increase" Click="DelayUp_Click"/>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Focus delay before switching" Style="{StaticResource ItemTitle}"/>
                        <TextBlock Style="{StaticResource Sub}" FontSize="13" Margin="0,4,0,0"
                                   Text="A game must stay focused this long before the category changes. Clicking back to the current game (or anything else) within this time cancels the switch."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="WHEN SWITCHING" Style="{StaticResource Caps}" Margin="0,24,0,8"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12">
                <StackPanel>
                    <DockPanel Margin="20,14">
                        <CheckBox x:Name="TitleToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Update stream title on switch" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Fills %gameName%, %fullGameName% and %customName% in your title template. Only sent when the text actually changes."
                                       Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <DockPanel Margin="20,14">
                        <CheckBox x:Name="ToastToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Toast notification on switch" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Small Windows notification when the category or title changes." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <DockPanel Margin="20,14">
                        <CheckBox x:Name="FullscreenToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                        <StackPanel>
                            <TextBlock Text="No toasts over fullscreen games" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Skips the notification while a fullscreen game or presentation is running." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <StackPanel Margin="20,14">
                        <DockPanel>
                            <CheckBox x:Name="FallbackToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Pref_Changed" Unchecked="Pref_Changed"/>
                            <StackPanel>
                                <TextBlock Text="Fallback category when the game closes" Style="{StaticResource ItemTitle}"/>
                                <TextBlock Text="Switch to this category after the current mapped game exits." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <local:CategoryPicker x:Name="FallbackPicker" Margin="0,12,0,0" ResultsMaxHeight="240"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
