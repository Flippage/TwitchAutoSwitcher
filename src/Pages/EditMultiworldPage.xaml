<UserControl x:Class="AutoSwitcher.EditMultiworldPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoSwitcher">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}"
                    Background="{StaticResource FieldBrush}" Width="44" Height="44" ToolTip="Close" Click="Cancel_Click"/>
            <TextBlock x:Name="Heading" Text="New multiworld" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="NAME" Style="{StaticResource Caps}" Margin="0,0,0,8"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Field}" Tag="e.g. Multiworld Day 2" MaxLength="60"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,22,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PillButton}" Content="Select all" Click="All_Click" Margin="0,0,6,0"/>
                <Button Style="{StaticResource PillButton}" Content="Select none" Click="None_Click"/>
            </StackPanel>
            <TextBlock x:Name="GamesHeading" Text="GAMES" Style="{StaticResource Caps}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PickList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:WorldPick}">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="8,8,16,8" Margin="0,0,0,8"
                                Cursor="Hand" MouseLeftButtonUp="Row_Click" BorderThickness="2" BorderBrush="{Binding Outline}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Selected, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                                <Border Width="36" Height="48" CornerRadius="4" DockPanel.Dock="Left" local:Art.Url="{Binding Cat.BoxArtUrl}"/>
                                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Cat.Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SubBrush}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="NoGames" Grid.Row="3" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Add games on Mappings first, then come back to group them into a multiworld." Visibility="Collapsed"/>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource OutlineButton}" Content="Save" Click="Save_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource AccentButton}" Content="Save &amp; activate" Click="SaveActivate_Click"
                        ToolTip="Save, then turn these games on and pause the rest"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
