<UserControl x:Class="AutoSwitcher.MappingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoSwitcher">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Stroke="Black" StrokeThickness="3"/>
                    </Viewbox>
                    <TextBlock Text="Add category"/>
                </StackPanel>
            </Button>
            <Grid DockPanel.Dock="Right" Margin="0,0,10,0">
                <Button x:Name="SortBtn" Style="{StaticResource OutlineButton}" Padding="16,0" Click="Sort_Click" ToolTip="Sort the list">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSort}" Stroke="{StaticResource Text2Brush}" StrokeThickness="2.2"/>
                        </Viewbox>
                        <TextBlock x:Name="SortLabel" Text="Oldest first" FontWeight="Normal" Foreground="{StaticResource Text2Brush}"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortBtn}" Placement="Bottom" VerticalOffset="6"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#1A1A1A" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" CornerRadius="12" MinWidth="220"
                            TextElement.FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource TextBrush}">
                        <ListBox x:Name="SortList" Style="{StaticResource ResultList}" Background="Transparent" FontSize="13.5"
                                 DisplayMemberPath="Label" PreviewMouseLeftButtonUp="SortList_Click" KeyDown="SortList_KeyDown"/>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock Text="Game Mappings" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Active multiworld -->
        <Border x:Name="WorldBanner" Grid.Row="1" Margin="0,16,0,0" Padding="16,10,10,10" CornerRadius="12" Visibility="Collapsed"
                Background="{StaticResource AccentDimBrush}" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Deactivate" Click="DeactivateWorld_Click"
                        Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentLineBrush}" VerticalAlignment="Center"
                        ToolTip="Turn the multiworld off and put your games back how they were"/>
                <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconGlobe}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                </Viewbox>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text2Brush}" Margin="0,0,12,0">
                    <Run x:Name="WorldBannerName" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/> is active, so only its games are on.
                    Turning a game on or off here deactivates it.
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Mappings list -->
        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MapList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CategoryRow}">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="8,8,10,8" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding Category}"
                                              ToolTip="{Binding ToggleTip}" Click="Enabled_Click" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPencil}" ToolTip="Edit"
                                            CommandParameter="{Binding Category}" Click="Edit_Click"/>
                                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}" ToolTip="Remove"
                                            CommandParameter="{Binding Category}" Click="Delete_Click"/>
                                </StackPanel>
                                <Border Width="40" Height="54" CornerRadius="4" DockPanel.Dock="Left" local:Art.Url="{Binding Category.BoxArtUrl}"
                                        Opacity="{Binding ContentOpacity}"/>
                                <StackPanel Margin="16,0,8,0" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Category.Name}" Style="{StaticResource ItemTitle}"
                                                   TextTrimming="CharacterEllipsis" Opacity="{Binding ContentOpacity}"/>
                                        <Border DockPanel.Dock="Left" Visibility="{Binding PausedTag}" CornerRadius="6" Padding="6,1,6,2"
                                                Margin="10,0,0,0" VerticalAlignment="Center" Background="{StaticResource HoverBrush}">
                                            <TextBlock Text="PAUSED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Text2Brush}"/>
                                        </Border>
                                        <Border/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,2,0,0" Opacity="{Binding ContentOpacity}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ExeChip}">
                                                <Border CornerRadius="6" Padding="8,3" Margin="0,4,6,0" Background="{Binding Background}"
                                                        ToolTip="{Binding Path}">
                                                    <!-- One TextBlock with two runs so name and file share a baseline -->
                                                    <TextBlock FontSize="11.5">
                                                        <Run Text="{Binding CustomPrefix, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Foreground, Mode=OneWay}"/><Run Text="    " FontSize="8"/><Run Text="{Binding File, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#7A7A7A"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="No games mapped yet" Style="{StaticResource ItemTitle}" HorizontalAlignment="Center"/>
            <TextBlock Text="Add a Twitch category and the executables that should switch to it." Style="{StaticResource Sub}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
