<UserControl x:Class="AutoSwitcher.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,24">
            <TextBlock Text="Account" Style="{StaticResource H1}"/>

            <!-- One-time: Twitch application Client ID -->
            <Border x:Name="SetupCard" Style="{StaticResource Card}" Padding="24" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="One-time setup: Twitch Client ID" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="13.5" Margin="0,8,0,0" Foreground="#B5B5B5"
                               Text="AutoSwitcher talks to Twitch as your own small 'application'. Create it once (free, takes a minute):"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="13.5" Margin="0,10,0,0" Foreground="{StaticResource Text2Brush}"
                               LineHeight="22"
                               Text="1.  Open the Twitch developer console and click 'Register Your Application'.&#10;2.  Name: anything (e.g. AutoSwitcher-yourname). OAuth Redirect URL: http://localhost&#10;3.  Category: Application Integration.  Client Type: Public.&#10;4.  Create, then copy the Client ID and paste it below."/>
                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Save" Click="SaveClientId_Click" Margin="10,0,0,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Open developer console" Click="OpenConsole_Click" Margin="10,0,0,0"/>
                        <TextBox x:Name="ClientIdSetupBox" Style="{StaticResource Field}" Tag="Paste Client ID"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Signed out: device code login -->
            <Border x:Name="SignedOutCard" Style="{StaticResource Card}" Padding="24" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Connect your Twitch account" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="13.5" Margin="0,6,0,0" Foreground="#B5B5B5"
                               Text="You'll get a short code. Sign in at twitch.tv/activate on any device and enter it. AutoSwitcher only asks to edit your stream title and category."/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource AccentButton}" Content="Connect with Twitch" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Click="Connect_Click"/>

                    <StackPanel x:Name="DevicePanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="CodeChars">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="44" Height="56" CornerRadius="10" Margin="0,0,8,0" Background="#1F1F1F"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="24" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCopy}" Background="#1F1F1F"
                                    Width="44" Height="44" ToolTip="Copy code" Click="CopyCode_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Open twitch.tv/activate" Click="OpenActivate_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="CancelLogin_Click" Margin="10,0,0,0"/>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                            <TextBlock x:Name="WaitText" Style="{StaticResource Sub}" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="LoginError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Signed in -->
            <Border x:Name="SignedInCard" Style="{StaticResource Card}" Padding="20,18" Margin="0,20,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Disconnect" Click="Disconnect_Click" VerticalAlignment="Center"/>
                    <Border x:Name="ProfileArt" Width="56" Height="56" CornerRadius="28" DockPanel.Dock="Left"/>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileName" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Connected · token renews automatically" FontSize="13" Foreground="{StaticResource GoodBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- App options -->
            <TextBlock Text="APP" Style="{StaticResource Caps}" Margin="0,26,0,8"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12">
                <StackPanel>
                    <DockPanel Margin="20,14">
                        <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Launch minimised to the system tray when you sign in." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <DockPanel Margin="20,14">
                        <CheckBox x:Name="TrayToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Tray_Changed" Unchecked="Tray_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Close to tray" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Closing the window keeps AutoSwitcher watching for games. Exit from the tray icon." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <TextBlock Text="ADVANCED" Style="{StaticResource Caps}" Margin="0,26,0,8"/>
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Twitch Client ID" Style="{StaticResource ItemTitle}"/>
                    <TextBlock Text="Changing this disconnects your account." Style="{StaticResource Sub}" Margin="0,2,0,10"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Save" Click="SaveClientIdAdvanced_Click" Margin="10,0,0,0"/>
                        <TextBox x:Name="ClientIdBox" Style="{StaticResource Field}" FontFamily="{StaticResource MonoFont}" Tag="Client ID"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0">
                        <Run Text="Settings are stored in "/><Run x:Name="ConfigPathRun" FontFamily="{StaticResource MonoFont}"/><Run Text=". Tokens are encrypted for your Windows user (DPAPI)."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
