<UserControl x:Class="AutoSwitcher.EditCategoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoSwitcher">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}"
                    Background="{StaticResource FieldBrush}" Width="44" Height="44" ToolTip="Close" Click="Cancel_Click"/>
            <TextBlock x:Name="Heading" Text="Add category" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: category -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8" Height="24">
                    <TextBlock Text="1 · TWITCH CATEGORY" Style="{StaticResource Caps}" VerticalAlignment="Center"/>
                    <Border CornerRadius="10" Padding="9,2,9,3" Margin="10,0,0,0" VerticalAlignment="Center" Background="{StaticResource AccentDimBrush}"
                            BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1"
                            ToolTip="Used for the Game Name pill in your stream title">
                        <TextBlock Text="Game Name" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <local:CategoryPicker x:Name="Picker" ResultsMaxHeight="380"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Right: executables -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8" Height="24">
                    <TextBlock Text="2 · EXECUTABLES" Style="{StaticResource Caps}" VerticalAlignment="Center"/>
                    <Border CornerRadius="10" Padding="9,2,9,3" Margin="10,0,0,0" VerticalAlignment="Center" Background="{StaticResource AccentDimBrush}"
                            BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1"
                            ToolTip="Used for the Game Executable Name pill in your stream title">
                        <TextBlock Text="Game Executable Name" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <Border CornerRadius="10" Padding="9,2,9,3" Margin="6,0,0,0" VerticalAlignment="Center" Background="{StaticResource AccentDimBrush}"
                            BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1"
                            ToolTip="Used for the Custom Name pill in your stream title">
                        <TextBlock Text="Custom Name" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource OutlineButton}" Height="46" Click="Browse_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Stroke="{StaticResource TextBrush}"/>
                                </Viewbox>
                                <TextBlock Text="Browse for .exe…"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PickRunningBtn" Grid.Column="1" Style="{StaticResource OutlineButton}" Height="46" Click="PickRunning_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconWindow}" Stroke="{StaticResource TextBrush}"/>
                                </Viewbox>
                                <TextBlock Text="Pick running"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Sub}" Margin="2,10,0,0"
                               Text="Game Executable Name is read from the exe's product info (falls back to the file name). Custom Name falls back to the Game Executable Name. Switching between these keeps the category; the title only changes if its filled-in text changes."/>

                    <Popup x:Name="RunningPopup" PlacementTarget="{Binding ElementName=PickRunningBtn}" Placement="Top"
                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                        <Border Width="440" Background="#1A1A1A" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                                CornerRadius="12" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="RUNNING APPS" Style="{StaticResource Caps}" Margin="10,6,0,6"/>
                                <ListBox x:Name="RunningList" Style="{StaticResource ResultList}" Background="Transparent" Padding="0"
                                         MaxHeight="320" PreviewMouseLeftButtonUp="RunningList_Click">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:RunningApp}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding WindowTitle}" FontSize="12" Foreground="{StaticResource SubBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="ExeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ExeMapping}">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,10,6,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}"
                                                    ToolTip="Remove executable" CommandParameter="{Binding}" Click="RemoveExe_Click"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel Margin="0,0,6,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="GAME EXECUTABLE NAME" Style="{StaticResource Caps}" FontSize="10" ToolTip="Read from the exe's product info. You can edit it."/>
                                                        <TextBox Style="{StaticResource FlatField}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="CUSTOM NAME" Style="{StaticResource Caps}" FontSize="10"/>
                                                        <TextBox Style="{StaticResource FlatField}" Foreground="{StaticResource AccentBrush}" Tag="Uses the executable name"
                                                                 Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" Margin="0,6,0,0" ToolTip="{Binding Path}"/>

                                                <!-- Emulators: same exe, different games → match by window title -->
                                                <CheckBox Style="{StaticResource Toggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                          IsChecked="{Binding MatchTitle, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="For emulators and launchers: only use this mapping when the window title matches">
                                                    <TextBlock Text="Match window title" FontSize="12.5" Foreground="{StaticResource Text2Brush}"/>
                                                </CheckBox>
                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding MatchTitle, Converter={StaticResource BoolToVis}}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Use current title"
                                                                CommandParameter="{Binding}" Click="GrabTitle_Click" Margin="10,0,0,0"
                                                                ToolTip="Copy the title of this exe's window (it must be running)"/>
                                                        <TextBox Style="{StaticResource FlatField}" FontWeight="Normal"
                                                                 Text="{Binding TitlePattern, UpdateSourceTrigger=PropertyChanged}"
                                                                 Tag="Title contains… e.g. Donkey Kong 64 USA"/>
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Margin="0,6,0,0"
                                                               Text="Matches when the window title contains this text (any case). Delete parts that change, or use * for them, e.g. Donkey Kong 64*USA."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoExes" Style="{StaticResource Sub}" Margin="2,4,0,8"
                                   Text="No executables yet. Browse for one, or pick a game that's running right now."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource AccentButton}" Content="Save category" Click="Save_Click"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
