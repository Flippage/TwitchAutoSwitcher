<UserControl x:Class="AutoSwitcher.ManualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoSwitcher">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Manual stream info" Style="{StaticResource H1}"/>

        <!-- Banner: paused (warning) or info -->
        <Border x:Name="Banner" Grid.Row="1" Margin="0,16,0,0" CornerRadius="12" Padding="16,10" BorderThickness="1">
            <DockPanel>
                <Button x:Name="ResumeBtn" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Resume auto"
                        Click="Resume_Click" Foreground="{StaticResource WarnTextBrush}" BorderBrush="{StaticResource WarnLineBrush}"/>
                <Viewbox x:Name="BannerIcon" Width="18" Height="18" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPause}" Stroke="{StaticResource WarnBrush}"/>
                </Viewbox>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13.5" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconRefresh}"
                                    Width="28" Height="28" ToolTip="Refresh from Twitch" Click="Refresh_Click"/>
                            <TextBlock Text="CURRENTLY LIVE ON TWITCH" Style="{StaticResource Caps}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <DockPanel>
                                <Border x:Name="LiveArt" Width="60" Height="80" CornerRadius="4" DockPanel.Dock="Left"/>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveGame" Style="{StaticResource ItemTitle}" FontSize="16" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LiveTitle" FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NEW CATEGORY (OPTIONAL)" Style="{StaticResource Caps}" Margin="0,7,0,15"/>
                        <local:CategoryPicker x:Name="Picker" ResultsMaxHeight="240"/>
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,22,0,8">
                    <TextBlock x:Name="Counter" DockPanel.Dock="Right" Style="{StaticResource Sub}"/>
                    <TextBlock Text="STREAM TITLE" Style="{StaticResource Caps}"/>
                </DockPanel>
                <TextBox x:Name="TitleBox" Style="{StaticResource TextArea}" MaxLength="140" Tag="Stream title"
                         TextChanged="TitleBox_TextChanged"/>
                <WrapPanel x:Name="RecentPanel" Margin="0,10,0,0">
                    <TextBlock Text="Recent:" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PillButton}" Content="{Binding}" CommandParameter="{Binding}"
                                        Click="Recent_Click" Margin="0,0,8,6" MaxWidth="360"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="Update title only" Click="TitleOnly_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource AccentButton}" Content="Apply to Twitch" Click="Apply_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
        </DockPanel>
    </Grid>
</UserControl>
