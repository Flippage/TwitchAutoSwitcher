<Window x:Class="AutoSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoSwitcher"
        Title="AutoSwitcher" Icon="pack://application:,,,/Assets/app.ico" Width="1100" Height="950" MinWidth="920" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SideBrush}">
            <DockPanel x:Name="SideDock" Margin="0,24,0,16">
                <StackPanel x:Name="SideHeader" DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,0,24,24">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <Viewbox Width="18" Height="18">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconSwitch}" Stroke="Black" StrokeThickness="2.4"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="AutoSwitcher" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Account chip -->
                <Border x:Name="AccountChip" DockPanel.Dock="Bottom" Margin="16,0" Padding="12" CornerRadius="10" Background="#141414">
                    <DockPanel>
                        <Border x:Name="Avatar" Width="32" Height="32" CornerRadius="16" Background="#3A3A3A" DockPanel.Dock="Left">
                            <TextBlock x:Name="AvatarLetter" Text="?" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountName" Text="Not connected" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AccountStatus" Text="Open Settings to connect" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Live / Offline -->
                <Border x:Name="LiveBadge" DockPanel.Dock="Bottom" Margin="16,0,16,8" Padding="12,9" CornerRadius="10"
                        Background="#141414" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveGlow" Width="18" Height="18" Margin="-4" Opacity="0.25"/>
                            <Ellipse x:Name="LiveDot"/>
                        </Grid>
                        <TextBlock x:Name="LiveText" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ViewerText" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- On Stream panel: persists on every page -->
                <Border x:Name="NowCard" DockPanel.Dock="Bottom" Margin="16,0,16,8" Padding="12" CornerRadius="12"
                        Background="#141414" BorderBrush="#262626" BorderThickness="2">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border x:Name="AutoOffTag" DockPanel.Dock="Right" CornerRadius="6" Padding="6,1,6,2"
                                    Background="{StaticResource WarnBgBrush}" BorderBrush="Transparent" BorderThickness="1"
                                    Visibility="Collapsed" VerticalAlignment="Center" Cursor="Hand"
                                    ToolTip="Auto-switch is paused. Click to resume."
                                    MouseLeftButtonUp="AutoOffTag_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource WarnLineBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock x:Name="AutoOffText" Text="AUTO OFF" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                            <TextBlock x:Name="NowLabel" Text="ON STREAM" Style="{StaticResource Caps}" FontSize="10.5" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid x:Name="NowArtBox" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Border x:Name="NowArt" Width="84" Height="112" CornerRadius="6" Background="#1F1F1F"/>
                            <Viewbox x:Name="NowArtIdle" Width="34" Height="34" Opacity="0.25" IsHitTestVisible="False">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSwitch}" Stroke="{StaticResource TextBrush}"/>
                            </Viewbox>
                        </Grid>
                        <TextBlock x:Name="NowGame" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowExe" FontSize="11.5" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SubBrush}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock x:Name="NowError" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>

                        <!-- Running mapped games that aren't on stream: a stack you can flip through -->
                        <Grid x:Name="DetStack" Margin="0,0,0,0" Visibility="Collapsed" Opacity="0">
                            <Border x:Name="DetBack2" Margin="-8,16" CornerRadius="9" BorderThickness="1" Visibility="Collapsed"/>
                            <Border x:Name="DetBack1" Margin="-4,8" CornerRadius="9" BorderThickness="1" Visibility="Collapsed"/>
                            <Border x:Name="DetBox" Padding="8" CornerRadius="9" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel x:Name="DetContent">
                                        <DockPanel>
                                            <TextBlock x:Name="DetCounter" DockPanel.Dock="Right" FontSize="9.5" LineHeight="13" LineStackingStrategy="BlockLineHeight" FontWeight="Bold"
                                                       Foreground="{StaticResource SubBrush}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="DetLabel" FontSize="9.5" LineHeight="13" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0" MinHeight="36">
                                            <Border x:Name="DetArt" Width="27" Height="36" CornerRadius="3" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DetName" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="DetExe" FontSize="10.5" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SubBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border x:Name="DetBarTrack" Height="3" CornerRadius="2" Margin="0,7,0,0"
                                                Background="{StaticResource AccentLineBrush}" Visibility="Collapsed">
                                            <Border CornerRadius="2" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="DetBarScale" ScaleX="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DetPrev" Style="{StaticResource PillButton}" Width="0" Height="22" Padding="0"
                                                Margin="0" Opacity="0" IsHitTestVisible="False" IsTabStop="False" ClipToBounds="True" ToolTip="Previous game" Click="DetPrev_Click">
                                            <Viewbox Width="9" Height="9">
                                                <Path Style="{StaticResource Icon}" Data="M15,6 L9,12 L15,18" StrokeThickness="3.2"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                        </Button>
                                        <Button x:Name="DetBtn" Grid.Column="1" Style="{StaticResource PillButton}" Height="26" Padding="4,0"
                                                FontWeight="Bold" Click="SwitchNow_Click" AutomationProperties.Name="Switch now"/>
                                        <Button x:Name="DetNext" Grid.Column="2" Style="{StaticResource PillButton}" Width="0" Height="22" Padding="0"
                                                Margin="0" Opacity="0" IsHitTestVisible="False" IsTabStop="False" ClipToBounds="True" ToolTip="Next game" Click="DetNext_Click">
                                            <Viewbox Width="9" Height="9">
                                                <Path Style="{StaticResource Icon}" Data="M9,6 L15,12 L9,18" StrokeThickness="3.2"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                        </Button>
                                        <!-- Label sits over the whole row (not inside the button), so it stays perfectly still
                                             while the button narrows/widens for the ‹ › arrows. -->
                                        <TextBlock x:Name="DetBtnText" Grid.ColumnSpan="3" Text="Switch now" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="#242424" Margin="0,12,0,8"/>
                        <DockPanel Margin="0,2,0,0">
                            <CheckBox x:Name="SideAutoToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}"
                                      Checked="SideAuto_Changed" Unchecked="SideAuto_Changed" ToolTip="Switch category automatically"/>
                            <TextBlock Text="Auto-switch" FontSize="12.5" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <CheckBox x:Name="SideTitleToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}"
                                      Checked="SideTitle_Changed" Unchecked="SideTitle_Changed" ToolTip="Update the stream title on switch"/>
                            <TextBlock Text="Auto title" FontSize="12.5" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Menu: least-used last -->
                <StackPanel x:Name="NavMenu" VerticalAlignment="Top">
                    <RadioButton x:Name="NavMappings" Style="{StaticResource NavButton}" Content="Mappings" Tag="{StaticResource IconHome}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMultiworlds" Style="{StaticResource NavButton}" Content="Multiworlds" Tag="{StaticResource IconGlobe}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTitles" Style="{StaticResource NavButton}" Content="Stream Titles" Tag="{StaticResource IconTitles}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavManual" Style="{StaticResource NavButton}" Content="Manual" Tag="{StaticResource IconPencil}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBehaviour" Style="{StaticResource NavButton}" Content="Behaviour" Tag="{StaticResource IconSliders}" Checked="Nav_Checked"/>
                    <Grid>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Settings" Tag="{StaticResource IconGear}" Checked="Nav_Checked"/>
                        <Border x:Name="UpdateBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                CornerRadius="8" Padding="7,1,7,2" Background="{StaticResource WarnBgBrush}"
                                BorderBrush="{StaticResource WarnLineBrush}" BorderThickness="1"
                                IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock Text="Update" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="Host" Grid.Column="1" Focusable="False"/>

        <!-- In-app update toast (bottom-right, 10 s, pauses on hover) -->
        <Border x:Name="UpdateToast" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Width="360" CornerRadius="14" Background="#1A1A1A" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                Visibility="Collapsed" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="16,16,12,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}"
                            Width="32" Height="32" VerticalAlignment="Top" ToolTip="Dismiss" Click="ToastClose_Click"/>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentDimBrush}"
                            VerticalAlignment="Top" Margin="0,0,14,0">
                        <Viewbox Width="20" Height="20">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconDownload}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"/>
                        </Viewbox>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="A new update is available" FontSize="14.5" FontWeight="Bold"/>
                        <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="#B5B5B5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource AccentButton}" Height="34" Padding="16,0" FontSize="13" Content="Update now"
                                    Click="ToastUpdate_Click"/>
                            <Button Style="{StaticResource OutlineButton}" Height="34" Padding="14,0" FontSize="13" FontWeight="Normal"
                                    Foreground="{StaticResource Text2Brush}" Content="What's new" Margin="8,0,0,0" Click="ToastNotes_Click"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource AccentDimBrush}">
                    <Border Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ToastBarScale" ScaleX="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
        <!-- In-app confirmation dialog (replaces Windows message boxes) -->
        <Grid x:Name="ConfirmLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="#B8000000" MouseLeftButtonDown="ConfirmBackdrop_MouseDown"/>
            <Border x:Name="ConfirmCard" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Background="#1A1A1A" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Padding="24"
                    RenderTransformOrigin="0.5,0.5" Focusable="True" FocusVisualStyle="{x:Null}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.7" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ConfirmScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <DockPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource DangerBgBrush}"
                                BorderBrush="{StaticResource DangerLineBrush}" BorderThickness="1" DockPanel.Dock="Left" VerticalAlignment="Top">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}" StrokeThickness="2.2"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock x:Name="ConfirmTitle" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ConfirmMessage" FontSize="13" Foreground="{StaticResource Text2Brush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="ConfirmItem" Margin="0,18,0,0" Padding="10" CornerRadius="10" Background="#121212"
                            BorderBrush="#262626" BorderThickness="1" Visibility="Collapsed">
                        <DockPanel>
                            <Border x:Name="ConfirmArt" Width="36" Height="48" CornerRadius="4" Background="#1F1F1F" DockPanel.Dock="Left"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConfirmItemName" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ConfirmItemSub" FontSize="12" Foreground="{StaticResource SubBrush}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="ConfirmNo" Content="Cancel" Style="{StaticResource OutlineButton}" Height="40" MinWidth="104"
                                IsCancel="True" Click="ConfirmNo_Click"/>
                        <Button x:Name="ConfirmYes" Content="Remove" Style="{StaticResource DangerButton}" Height="40" MinWidth="104"
                                Margin="10,0,0,0" IsDefault="True" Click="ConfirmYes_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
